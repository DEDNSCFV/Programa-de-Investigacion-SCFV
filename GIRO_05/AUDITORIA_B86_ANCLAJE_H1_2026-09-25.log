════ IV · ProyeccionDecisionesH2 · qué registra ════
CREATE TABLE proyeccion_decisiones_h2 (
    evento_id INTEGER PRIMARY KEY,
    asiento_id TEXT NOT NULL,
    correlation_id TEXT NOT NULL,
    justificacion TEXT,
    conflictos_detectados INTEGER DEFAULT 0,
    normas_aplicadas TEXT,
    fecha_decision DATE NOT NULL
);
CREATE INDEX idx_decisiones_correlation ON proyeccion_decisiones_h2(correlation_id);
CREATE INDEX idx_decisiones_fecha ON proyeccion_decisiones_h2(fecha_decision);

