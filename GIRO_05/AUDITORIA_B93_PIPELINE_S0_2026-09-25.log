════ VI · event_store → schema ════
CREATE TABLE event_store (
                id INTEGER PRIMARY KEY,
                tipo_evento TEXT NOT NULL,
                payload TEXT NOT NULL,
                correlation_id TEXT NOT NULL,
                idempotency_key TEXT UNIQUE NOT NULL,
                hash_previo TEXT NOT NULL,
                hash_actual TEXT NOT NULL,
                timestamp INTEGER NOT NULL,
                version_contexto TEXT
            );
CREATE TRIGGER actualizar_decisiones_h2
AFTER INSERT ON event_store
WHEN NEW.tipo_evento = 'ASIENTO_REGISTRADO'
BEGIN
    INSERT INTO proyeccion_decisiones_h2 (
        evento_id,
        asiento_id,
        correlation_id,
        justificacion,
        conflictos_detectados,
        normas_aplicadas,
        fecha_decision
    )
    SELECT
        NEW.id,
        json_extract(NEW.payload, '$.id'),
        NEW.correlation_id,
        json_extract(NEW.payload, '$.justificacion_h2'),
        (SELECT COUNT(*) FROM json_each(NEW.payload, '$.conflictos')),
        json_extract(NEW.payload, '$.normas_aplicadas'),
        date(NEW.timestamp, 'unixepoch')
    FROM (SELECT 1) AS dummy;
END;

