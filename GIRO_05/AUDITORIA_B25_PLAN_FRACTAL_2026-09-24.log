from typing import Dict, List, Optional
"""
Fractal de Ventas (v8.1 con I6)
"""
from DOMINIOS.base_fractal import BaseFractal

class FractalVentas(BaseFractal):
    def evaluar(self, evidencia: Dict, contexto: Dict, normas_aplicables: List[Dict] = None) -> List[Dict]:
        if normas_aplicables is not None:
            self.normas_aplicables = normas_aplicables

        tipo = evidencia.get('tipo', '').lower().strip()
        monto = evidencia.get('monto', 0)
        if tipo == 'venta' and monto > 0:
            # Buscar la norma de IVA aplicable (por simplicidad, la primera que tenga tipo 'aplicar_tasa')
            norma_iva = None
            for n in self.normas_aplicables:
                if n.get('accion_sugerida', {}).get('tipo') == 'aplicar_tasa':
                    norma_iva = n
                    break

            if norma_iva:
                tasa = norma_iva.get('accion_sugerida', {}).get('valor', 0.12)
                norma_id = norma_iva.get('id')
            else:
                tasa = contexto.get('NORMATIVO_GLOBAL_IVA_TASA_GENERAL', 0.12)
                norma_id = None

            base = monto / (1 + tasa)
            iva = monto - base

            consecuencias = [
                {"cuenta": "110101", "naturaleza": "DEUDORA", "movimiento": "AUMENTA", "monto": monto},
                {"cuenta": "410101", "naturaleza": "ACREEDORA", "movimiento": "AUMENTA", "monto": base},
                {"cuenta": "210201", "naturaleza": "ACREEDORA", "movimiento": "AUMENTA", "monto": iva,
                 "es_fiscal": True, "norma_id": norma_id}  # I6
            ]
            return consecuencias
        return []
